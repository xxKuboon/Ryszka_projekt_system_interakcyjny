{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.task_list'|trans }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.task_list'|trans }}</h1>
    {% if pagination is defined and pagination.items|length %}

        <div class="navigation text-center">
            {{ knp_pagination_render(pagination) }}
        </div>

        <table class="table table-striped">
            <thead>
            <tr>
                <th>{{ knp_pagination_sortable(pagination, 'NUMER'|trans, 'task.id') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'DATA UTOWORZENIA'|trans, 'task.createdAt') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'OSTATNIA AKTUALIZACJA'|trans, 'task.updatedAt') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'TYTUŁ'|trans, 'task.title') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'KATEGORIA'|trans, 'category.title') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'AUTOR'|trans, 'author.email') }}</th>
                <th>{{ 'AKCJE'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for task in pagination.items %}
                <tr>
                    <td>{{ task.id }}</td>
                    <td>{{ task.createdAt|format_date('long') }}</td>
                    <td>{{ task.updatedAt|format_date('long') }}</td>
                    <td>{{ task.title }}</td>
                    <td>{{ task.category.title }}</td>
                    <td>{{ task.author ? task.author.email : '-' }}</td>
                    <td>
                        {% if is_granted('TASK_VIEW', task) %}
                            <a class="btn btn-outline-primary btn-sm" href="{{ url('task_view', {id: task.id}) }}" title="{{ 'action.show'|trans }}">
                                {{ 'action.show'|trans }}
                            </a>
                        {% endif %}

                        {% if is_granted('TASK_EDIT', task) %}
                            <a class="btn btn-outline-success btn-sm" href="{{ url('task_edit', {id: task.id}) }}" title="{{ 'action.edit'|trans }}">
                                {{ 'action.edit'|trans }}
                            </a>
                        {% endif %}

                        {% if is_granted('TASK_DELETE', task) %}
                            <a class="btn btn-outline-danger btn-sm" href="{{ url('task_delete', {id: task.id}) }}" title="{{ 'action.delete'|trans }}">
                                {{ 'action.delete'|trans }}
                            </a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="navigation text-center">
            {{ knp_pagination_render(pagination) }}
        </div>

    {% else %}
        <p>
            {{ 'message.empty_list'|trans }}
        </p>
    {% endif %}
{% endblock %}
