{% extends 'base.html.twig' %}

{% block title %}Lista kategorii{% endblock %}

{% block body %}
    <h1>Lista kategorii</h1>
    <a href="{{ url('category_create') }}" class="btn btn-outline-primary btn-sm"><h4>Dodaj nową kategorię</h4></a>
    <div>
        <a class="btn btn-outline-success btn-sm" href="{{ url('task_index') }}" title="{{ 'tasks'|trans }}">
            {{ 'tasks'|trans }}
        </a>
    </div>

    {% if pagination is defined and pagination|length %}
        <table class="table table-striped">
            <thead>
            <tr>
                <th>{{ knp_pagination_sortable(pagination, 'ID', 'category.id') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'Tytuł', 'category.title') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'Data utworzenia', 'category.createdAt') }}</th>
                <th>{{ knp_pagination_sortable(pagination, 'Data aktualizacji', 'category.updatedAt') }}</th>
                <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            {% for category in pagination %}
                <tr>
                    <td>{{ category.id }}</td>
                    <td>{{ category.title }}</td>
                    <td>{{ category.createdAt|date('Y-m-d H:i:s') }}</td>
                    <td>{{ category.updatedAt|date('Y-m-d H:i:s') }}</td>
                    <td>
                        <a href="{{ url('category_view', {id: category.id}) }}" class="btn btn-outline-primary btn-sm">Pokaż szczegóły</a>
                        <a href="{{ url('category_edit', {id: category.id}) }}" class="btn btn-outline-primary btn-sm">Edytuj kategorię</a>
                        <a href="{{ url('category_delete', {id: category.id}) }}" class="btn btn-outline-primary btn-sm">Usuń kategorię</a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="navigation d-flex justify-content-center">
            {{ knp_pagination_render(pagination) }}
        </div>
    {% else %}
        <p>Brak kategorii do wyświetlenia.</p>
    {% endif %}
{% endblock %}
